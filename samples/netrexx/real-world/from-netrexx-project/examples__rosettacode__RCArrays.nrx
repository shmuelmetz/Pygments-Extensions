/*----------------------------------------------------------------------------
Real-world sample gathered for lexer validation (not written for this project).
Source: https://sourceforge.net/p/netrexx/code/ci/master/tree/examples/rosettacode/RCArrays.nrx
Project: NetRexx (the official RexxLA/IBM reference implementation)
License: ICU License (ICU 1.8.1 and later) -- see the source repo's LICENSE
         file for full terms. Retained here under those terms as part of
         pygments-extensions' own real-world lexer validation corpus; see
         samples/netrexx/real-world/README.md.
----------------------------------------------------------------------------*/
/* NetRexx */
options replace format comments java symbols nobinary

array = int[10]
array[0] = 42

say array[0] array[3]
say

words = ['Ogof', 'Ffynnon', 'Ddu']

say words[0] words[1] words[2]
say

-- Dynamic arrays can be simulated via the Java Collections package
splk = ArrayList()
splk.add(words[0])
splk.add(words[1])
splk.add(words[2])
splk.add('Draenen')

say splk.get(0) splk.get(3)
say splk.get(0) splk.get(1) splk.get(2)
say

-- or by using NetRexx "indexed strings" (associative arrays)
cymru = ''
cymru[0] = 0
cymru[0] = cymru[0] + 1; cymru[cymru[0]] = splk.get(0) splk.get(1) splk.get(2)
cymru[0] = cymru[0] + 1; cymru[cymru[0]] = splk.get(0) splk.get(3)

loop x_ = 1 to cymru[0] by 1
  say x_':' cymru[x_]
  end x_

