/*----------------------------------------------------------------------------
Real-world sample gathered for lexer validation (not written for this project).
Source: https://sourceforge.net/p/netrexx/code/ci/master/tree/examples/rosettacode/RCStringConcatenation.nrx
Project: NetRexx (the official RexxLA/IBM reference implementation)
License: ICU License (ICU 1.8.1 and later) -- see the source repo's LICENSE
         file for full terms. Retained here under those terms as part of
         pygments-extensions' own real-world lexer validation corpus; see
         samples/netrexx/real-world/README.md.
----------------------------------------------------------------------------*/
/* NetRexx */

options replace format comments java symbols

s1 = 'any text value'
s2 = 'another string literal'
s3 = s1    s2 -- concatenate variables with blank space (note that only one blank space is added)
s4 = s1 || s2 -- concatenate variables with abuttal (here, no blank spaces are added)
s5 = s1    'another string literal' -- concatenate a variable and a literal with blank space
s6 = s1'another string literal'     -- concatenate a variable and a literal using abuttal
s7 = s1 || 'another string literal' -- ditto

say 's1:' s1 -- concatenation with blank space is employed here too
say 's2:' s2
say 's3:' s3
say 's4:' s4
say 's5:' s5
say 's6:' s6
say 's7:' s7

