1      /*--------------------------------------------------------------+
       | Indices for (faster) access to countries in srch_nat()        |
       |                                                               |
       | 1: lower bound (may on occasion not include the most common   |
       |    value, and there are a number of indices that start before |
       |    the country so as to position a second most-used value in  |
       |    the middle (first-hit) position of the interval.           |
       |                                                               |
       | 2: upper bound, which may also extend into the range for the  |
       |    next country, for the same reason as mentioned above.      |
       +--------------------------------------------------------------*/
       2 filler          char      (16) init ('PLATES INDICES G'),
       2 g_pidx(26, 2)   fixed bin (31)  /*     #  max  mid  Original */
         init (  1,  10,   /* A     B       A   9  A    AM     1,   9 */
                 5,  45,   /* AM    DY      B  17  B    BY    10,  26 */
                27,  43,   /* C     DK      C  15  CZ   CO    27,  40 */
                39,  48,   /* CY    EAK     D   6  D    DK    41,  46 */
                47,  63,   /* E     FSM     E  12  E    EST   47,  57 */
                58,  64,   /* FIN   FSM     F   6  F    FL    58,  63 */
                64,  86,   /* G     IRL     G  14  GB   GR    64,  76 */
                77,  85,   /* H     IR      H   5  H    HR    77,  81 */
                82,  90,   /* I     JA      I   7  I    IRL   82,  88 */
                90,  90,   /* JA    JA      J   2  J    JA    89,  90 */
                86, 100,   /* IRL   KZ      K  10  KZ   KGZ   91, 100 */
                97, 117,   /* KS    MNE     L   7  LT   LV   101, 107 */
               108, 124,   /* M     NA      M  15  MA   MK   108, 122 */
               107, 140,   /* LV    PNG     N  11  NL   N    123, 132 */
               133, 133,   /*               O   1  OM   OM   133, 133 */
               132, 144,   /* NZ    Q       P  11  PL   PK   134, 143 */
               144, 144,   /*               Q   1  Q    Q    144, 144 */
               145, 187,   /* RA    TJ      R  24  RO   RUS  145, 167 */
               157, 184,   /* RM    T       S  19  S    SF   168, 183 */
               182, 198,   /* SY    USA     T  12  TR   TN   184, 194 */
               195, 201,   /* UA    V       U   5  UA   USA  195, 200 */
               201, 203,   /* V     VU      V   3  VN   VN   201, 203 */
               204, 212,   /* WAG   WV      W   9  WAN  WG   204, 212 */
                 0,   0,   /*               X   0              0,   0 */
               213, 215,   /* YAR   YV      Y   3  YU   YU   213, 215 */
               216, 218),  /* Z     ZW      Z   3  ZA   ZA   216, 218 */

