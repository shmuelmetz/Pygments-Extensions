                                    while(rtot_ptr ^= sysnull()),
               rtot_top;
   if rtot_ptr = rtot_top then
     call print_min_max_box('B');

   write file(outfile) from(rtot_list.rline);
 end;
 call print_min_max_box('B');

1/**********************************************************************
 * Print final min/max/avg tables per day                              *
 **********************************************************************/
 write file(outfile) from(iline);

